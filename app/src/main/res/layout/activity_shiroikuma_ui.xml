<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork (Phase 4): host of the 白い熊 Termux API UI page — a black toolbar with the
     yellow title and back arrow, then the preference fragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shiroikuma_black"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/shiroikuma_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/shiroikuma_black"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/shiroikuma_ui_title"
        app:titleTextColor="@color/shiroikuma_yellow" />

    <FrameLayout
        android:id="@+id/shiroikuma_ui_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
