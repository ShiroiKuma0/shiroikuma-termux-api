    <string name="shiroikuma_auto_switch">Automation export</string>
    <string name="shiroikuma_auto_switch_desc">Let sister apps (白い熊 応用管理 · 白い熊 自由作業盤) run this export headlessly and back the settings up. On by default.</string>
