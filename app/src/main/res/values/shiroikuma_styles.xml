<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma-termux-api fork (Phase 4): the theme of the 白い熊 Termux API UI page — black
     background, yellow ink, yellow accent (the row layouts read ?attr/colorAccent), black-yellow
     AlertDialogs. Nothing here touches upstream's activities. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Shiroikuma.Ui" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/shiroikuma_black</item>
        <item name="colorPrimaryDark">@color/shiroikuma_black</item>
        <item name="colorAccent">@color/shiroikuma_yellow</item>
        <item name="colorControlActivated">@color/shiroikuma_yellow</item>
        <item name="colorControlNormal">@color/shiroikuma_yellow_dim</item>
        <item name="colorControlHighlight">@color/shiroikuma_ripple</item>
        <item name="android:windowBackground">@color/shiroikuma_black</item>
        <item name="android:colorBackground">@color/shiroikuma_black</item>
        <item name="android:textColorPrimary">@color/shiroikuma_yellow</item>
        <item name="android:textColorSecondary">@color/shiroikuma_yellow_dim</item>
        <item name="android:textColorTertiary">@color/shiroikuma_yellow_dim</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/shiroikuma_black</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/shiroikuma_black</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="alertDialogTheme">@style/Theme.Shiroikuma.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Shiroikuma.Dialog</item>
    </style>

    <!-- The window itself is transparent: every dialog we show draws its own bordered box. -->
    <style name="Theme.Shiroikuma.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/shiroikuma_yellow</item>
        <item name="colorControlActivated">@color/shiroikuma_yellow</item>
        <item name="colorControlNormal">@color/shiroikuma_yellow_dim</item>
        <item name="colorControlHighlight">@color/shiroikuma_ripple</item>
        <item name="android:colorBackground">@color/shiroikuma_black</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/shiroikuma_yellow</item>
        <item name="android:textColorSecondary">@color/shiroikuma_yellow_dim</item>
        <item name="android:textColor">@color/shiroikuma_yellow</item>
    </style>

</resources>
