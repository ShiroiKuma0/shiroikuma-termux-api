<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- shiroikuma fork (Phase 4): the 白い熊 Termux API UI page, first -->
    <Preference
        app:key="shiroikuma_ui"
        app:title="@string/shiroikuma_ui_title"
        app:summary="@string/shiroikuma_ui_row_summary"
        app:persistent="false">
        <intent
            android:targetPackage="com.termux.api"
            android:targetClass="com.termux.api.shiroikuma.ui.ShiroikumaUiActivity" />
    </Preference>

    <Preference
        app:key="sets__termux_api_app"
        app:title="@string/sets__termux_api_app___val__title"
        app:summary="@string/sets__termux_api_app___val__summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.api.settings.fragments.termux_api_app.TermuxAPIPreferencesFragment"/>

    <Preference
        app:key="link__termux_about"
        app:title="@string/link__about___val__title"
        app:persistent="false"/>

</PreferenceScreen>
